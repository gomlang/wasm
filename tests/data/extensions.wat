(module
  (type $pair (func (param i32 i64) (result i32 i64)))
  (memory (export "memory") 1 1)
  (table $first (export "first") 3 5 funcref)
  (table $second (export "second") 4 4 funcref)
  (table $external (export "external") 1 3 externref)
  (data $bytes "abcdef")
  (elem $functions func $answer $other)
  (elem declare func $answer $other)
  (func $answer (export "answer") (result i32) i32.const 42)
  (func $other (result i32) i32.const 7)
  (func (export "multi") (param i32 i64) (result i32 i64)
    local.get 0 local.get 1
    block (type $pair)
      br 0
    end)
  (func (export "loop") (param $count i32) (result i32 i64)
    (local $sum i64)
    local.get $count i64.const 0
    loop $again (type $pair)
      local.set $sum local.set $count
      local.get $count i32.const 1 i32.sub local.tee $count
      local.get $sum i64.const 2 i64.add
      local.get $count br_if $again
    end)
  (func (export "choose") (param i32) (result i32 i64)
    i32.const 3 i64.const 4 local.get 0
    if (type $pair)
      drop drop i32.const 5 i64.const 6
    end)
  (func (export "init") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.init $bytes)
  (func (export "drop") data.drop $bytes)
  (func (export "copy") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.copy)
  (func (export "fill") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.fill)
  (func (export "table_init") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init $first $functions)
  (func (export "element_drop") elem.drop $functions)
  (func (export "table_copy") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $second $first)
  (func (export "table_overlap") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $first $first)
  (func (export "dispatch") (param i32) (result i32)
    local.get 0 call_indirect $second (result i32))
  (func (export "table_grow") (param i32) (result i32)
    ref.func $answer local.get 0 table.grow $first)
  (func (export "table_fill") (param i32 i32)
    local.get 0 ref.func $other local.get 1 table.fill $first)
  (func (export "external_set") (param externref)
    i32.const 0 local.get 0 table.set $external)
  (func (export "external_get") (result externref)
    i32.const 0 table.get $external)
  (func (export "external_choose") (param externref externref i32) (result externref)
    local.get 0 local.get 1 local.get 2 select (result externref))
  (func (export "external_null") (param externref) (result i32)
    local.get 0 ref.is_null)
  (func $fail unreachable)
  (func $middle call $fail)
  (func (export "fail") call $middle)
)
