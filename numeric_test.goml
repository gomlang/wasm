package wasm;

use std::testing;

fn numeric_test_result(op: isize, arguments: Vec[Value]) -> Value {
    let stack = Vec::from_array([Value::I32(123)]);
    for argument in arguments {
        stack.push(argument);
    }
    testing::expect_ok(execute_numeric(op, stack), f"numeric opcode {op}");
    testing::assert_eq(stack.len(), 2);
    testing::assert_eq(stack[0], Value::I32(123));
    stack[1]
}

fn numeric_test_equal(op: isize, arguments: Vec[Value], expected: Value) -> () {
    let actual = numeric_test_result(op, arguments);
    match (actual, expected) {
        (Value::F32(actual), Value::F32(expected)) => testing::assert_eq(
            actual.to_bits(),
            expected.to_bits(),
        ),
        (Value::F64(actual), Value::F64(expected)) => testing::assert_eq(
            actual.to_bits(),
            expected.to_bits(),
        ),
        _ => testing::assert_eq(actual, expected),
    }
}

fn numeric_test_trap(op: isize, arguments: Vec[Value], trap: Trap) -> () {
    testing::assert_eq(
        testing::expect_err(execute_numeric(op, arguments), f"trap for opcode {op}"),
        Error::Trap(trap),
    );
}

#[test]
fn numeric_every_mvp_opcode_dispatches_with_correct_operand_order() -> () {
    numeric_test_equal(0x45, Vec::from_array([Value::I32(0)]), Value::I32(1));
    numeric_test_equal(0x46, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(0));
    numeric_test_equal(0x47, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(1));
    numeric_test_equal(0x48, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(1));
    numeric_test_equal(0x49, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(0));
    numeric_test_equal(0x4a, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(0));
    numeric_test_equal(0x4b, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(1));
    numeric_test_equal(0x4c, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(1));
    numeric_test_equal(0x4d, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(0));
    numeric_test_equal(0x4e, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(0));
    numeric_test_equal(0x4f, Vec::from_array([Value::I32(-3), Value::I32(2)]), Value::I32(1));
    numeric_test_equal(0x50, Vec::from_array([Value::I64(0)]), Value::I32(1));
    numeric_test_equal(0x51, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(0));
    numeric_test_equal(0x52, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(1));
    numeric_test_equal(0x53, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(1));
    numeric_test_equal(0x54, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(0));
    numeric_test_equal(0x55, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(0));
    numeric_test_equal(0x56, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(1));
    numeric_test_equal(0x57, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(1));
    numeric_test_equal(0x58, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(0));
    numeric_test_equal(0x59, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(0));
    numeric_test_equal(0x5a, Vec::from_array([Value::I64(-3), Value::I64(2)]), Value::I32(1));
    numeric_test_equal(0x5b, Vec::from_array([Value::F32(-3.0), Value::F32(2.0)]), Value::I32(0));
    numeric_test_equal(0x5c, Vec::from_array([Value::F32(-3.0), Value::F32(2.0)]), Value::I32(1));
    numeric_test_equal(0x5d, Vec::from_array([Value::F32(-3.0), Value::F32(2.0)]), Value::I32(1));
    numeric_test_equal(0x5e, Vec::from_array([Value::F32(-3.0), Value::F32(2.0)]), Value::I32(0));
    numeric_test_equal(0x5f, Vec::from_array([Value::F32(-3.0), Value::F32(2.0)]), Value::I32(1));
    numeric_test_equal(0x60, Vec::from_array([Value::F32(-3.0), Value::F32(2.0)]), Value::I32(0));
    numeric_test_equal(0x61, Vec::from_array([Value::F64(-3.0), Value::F64(2.0)]), Value::I32(0));
    numeric_test_equal(0x62, Vec::from_array([Value::F64(-3.0), Value::F64(2.0)]), Value::I32(1));
    numeric_test_equal(0x63, Vec::from_array([Value::F64(-3.0), Value::F64(2.0)]), Value::I32(1));
    numeric_test_equal(0x64, Vec::from_array([Value::F64(-3.0), Value::F64(2.0)]), Value::I32(0));
    numeric_test_equal(0x65, Vec::from_array([Value::F64(-3.0), Value::F64(2.0)]), Value::I32(1));
    numeric_test_equal(0x66, Vec::from_array([Value::F64(-3.0), Value::F64(2.0)]), Value::I32(0));
    numeric_test_equal(0x67, Vec::from_array([Value::I32(16)]), Value::I32(27));
    numeric_test_equal(0x68, Vec::from_array([Value::I32(16)]), Value::I32(4));
    numeric_test_equal(0x69, Vec::from_array([Value::I32(16)]), Value::I32(1));
    numeric_test_equal(0x6a, Vec::from_array([Value::I32(-12), Value::I32(5)]), Value::I32(-7));
    numeric_test_equal(0x6b, Vec::from_array([Value::I32(-12), Value::I32(5)]), Value::I32(-17));
