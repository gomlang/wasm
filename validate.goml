package wasm;

// A missing operand type is the bottom type used only in unreachable code.

struct ValidationWork {
    limit: isize,
    used: Ref[isize],
}

impl ValidationWork {
    fn charge(self: ValidationWork, count: isize) -> Result[(), Error] {
        if count < 0 || count > self.limit - self.used.get() {
            return Result::Err(Error::Limit("validation work limit exceeded"))
        }
        self.used.set(self.used.get() + count);
        Result::Ok(())
    }
}

struct ValidationFrame {
    op: isize,
    height: isize,
    params: Vec[ValueType],
    results: Vec[ValueType],
    unreachable: Ref[bool],
    has_else: Ref[bool],
}

struct ValidationState {
    function: isize,
    offset: Ref[isize],
    values: Vec[Option[ValueType]],
    controls: Vec[ValidationFrame],
    limits: Limits,
    work: ValidationWork,
}

impl ValidationState {
    fn problem(self: ValidationState, message: string) -> Error {
        Error::Validation(self.function, self.offset.get(), message)
    }

    fn push(self: ValidationState, value: Option[ValueType]) -> Result[(), Error] {
        self.work.charge(1)?;
        if self.values.len() >= self.limits.max_stack {
            return Result::Err(Error::Limit("validation operand stack limit exceeded"))
        }
        self.values.push(value);
        Result::Ok(())
    }

    fn pop_any(self: ValidationState) -> Result[Option[ValueType], Error] {
        self.work.charge(1)?;
        let frame = self.controls[self.controls.len() - 1];
        if self.values.len() == frame.height && frame.unreachable.get() {
            return Result::Ok(Option::None)
        }
        if self.values.len() <= frame.height {
            return Result::Err(self.problem("operand stack underflow"))
        }
        Result::Ok(self.values.pop().unwrap_or(Option::None))
    }

    fn pop(self: ValidationState, expected: ValueType) -> Result[(), Error] {
        if let Some(actual) = self.pop_any()? {
            if actual != expected {
                return Result::Err(self.problem("operand type mismatch"))
            }
        }
        Result::Ok(())
    }

    fn pop_types(self: ValidationState, expected: Vec[ValueType]) -> Result[(), Error] {
        for i in 0..expected.len() {
            self.pop(expected[expected.len() - 1 - i])?;
        }
        Result::Ok(())
    }

    fn push_types(self: ValidationState, values: Vec[ValueType]) -> Result[(), Error] {
        for kind in values {
            self.push(Option::Some(kind))?;
        }
        Result::Ok(())
    }

    fn unreachable(self: ValidationState) -> () {
        let frame = self.controls[self.controls.len() - 1];
        self.values.truncate(frame.height);
        frame.unreachable.set(true);
    }

    fn label(self: ValidationState, depth: u32) -> Result[Vec[ValueType], Error] {
        self.work.charge(1)?;
        if depth.to_u64() >= self.controls.len().to_u64() {
            return Result::Err(self.problem("unknown branch label"))
        }
        let frame = self.controls[self.controls.len() - 1 - depth.to_isize()];
        Result::Ok(
            if frame.op == 0x03 {
                frame.params
            } else {
                frame.results
            },
        )
    }

    fn open(self: ValidationState, op: isize, signature: FuncType) -> Result[(), Error] {
        self.work.charge(1)?;
        if self.controls.len() >= self.limits.max_stack {
            return Result::Err(Error::Limit("validation control stack limit exceeded"))
        }
        self.controls.push(
            ValidationFrame {
                op,
                height: self.values.len(),
                params: signature.params,
                results: signature.results,
                unreachable: Ref::new(false),
                has_else: Ref::new(false),
            },
        );
        Result::Ok(())
    }

    fn close_values(self: ValidationState, frame: ValidationFrame) -> Result[(), Error] {
        self.pop_types(frame.results)?;
        if self.values.len() != frame.height {
            return Result::Err(self.problem("unexpected values at end of control frame"))
        }
        Result::Ok(())
    }

    fn call(self: ValidationState, signature: FuncType) -> Result[(), Error] {
        for index in 0..signature.params.len() {
            self.pop(signature.params[signature.params.len() - 1 - index])?;
        }
        for kind in signature.results {
            self.push(Option::Some(kind))?;
        }
        Result::Ok(())
    }
}

fn validation_numeric_signature(op: isize) -> Option[(ValueType, isize, ValueType)] {
    if op == 0xc0 || op == 0xc1 {
        return Option::Some((ValueType::I32, 1, ValueType::I32))
    }
    if op >= 0xc2 && op <= 0xc4 {
        return Option::Some((ValueType::I64, 1, ValueType::I64))
    }
    if op >= 0xfc00 && op <= 0xfc07 {
        let input = if op % 4 < 2 {
            ValueType::F32
        } else {
            ValueType::F64
        };
        let output = if op < 0xfc04 {
            ValueType::I32
        } else {
            ValueType::I64
        };
        return Option::Some((input, 1, output))
    }
    if op == 0x45 {
        return Option::Some((ValueType::I32, 1, ValueType::I32))
    }
    if op >= 0x46 && op <= 0x4f {
        return Option::Some((ValueType::I32, 2, ValueType::I32))
    }
    if op == 0x50 {
        return Option::Some((ValueType::I64, 1, ValueType::I32))
    }
    if op >= 0x51 && op <= 0x5a {
        return Option::Some((ValueType::I64, 2, ValueType::I32))
    }
    if op >= 0x5b && op <= 0x60 {
        return Option::Some((ValueType::F32, 2, ValueType::I32))
    }
    if op >= 0x61 && op <= 0x66 {
        return Option::Some((ValueType::F64, 2, ValueType::I32))
    }
    if op >= 0x67 && op <= 0x69 {
        return Option::Some((ValueType::I32, 1, ValueType::I32))
    }
    if op >= 0x6a && op <= 0x78 {
        return Option::Some((ValueType::I32, 2, ValueType::I32))
    }
    if op >= 0x79 && op <= 0x7b {
        return Option::Some((ValueType::I64, 1, ValueType::I64))
    }
    if op >= 0x7c && op <= 0x8a {
        return Option::Some((ValueType::I64, 2, ValueType::I64))
    }
    if op >= 0x8b && op <= 0x91 {
        return Option::Some((ValueType::F32, 1, ValueType::F32))
    }
    if op >= 0x92 && op <= 0x98 {
        return Option::Some((ValueType::F32, 2, ValueType::F32))
    }
    if op >= 0x99 && op <= 0x9f {
        return Option::Some((ValueType::F64, 1, ValueType::F64))
    }
    if op >= 0xa0 && op <= 0xa6 {
        return Option::Some((ValueType::F64, 2, ValueType::F64))
    }
    let pair = match op {
        0xa7 => (ValueType::I64, ValueType::I32),
        0xa8 | 0xa9 | 0xbc => (ValueType::F32, ValueType::I32),
        0xaa | 0xab => (ValueType::F64, ValueType::I32),
        0xac | 0xad => (ValueType::I32, ValueType::I64),
        0xae | 0xaf => (ValueType::F32, ValueType::I64),
        0xb0 | 0xb1 | 0xbd => (ValueType::F64, ValueType::I64),
        0xb2 | 0xb3 | 0xbe => (ValueType::I32, ValueType::F32),
        0xb4 | 0xb5 => (ValueType::I64, ValueType::F32),
        0xb6 => (ValueType::F64, ValueType::F32),
        0xb7 | 0xb8 => (ValueType::I32, ValueType::F64),
        0xb9 | 0xba | 0xbf => (ValueType::I64, ValueType::F64),
        0xbb => (ValueType::F32, ValueType::F64),
        _ => return Option::None,
    };
    Option::Some((pair.0, 1, pair.1))
}

fn validation_memory_signature(op: isize) -> (ValueType, u32) {
    match op {
        0x28 | 0x36 => (ValueType::I32, 2),
        0x29 | 0x37 => (ValueType::I64, 3),
        0x2a | 0x38 => (ValueType::F32, 2),
        0x2b | 0x39 => (ValueType::F64, 3),
        0x2c | 0x2d | 0x3a => (ValueType::I32, 0),
        0x2e | 0x2f | 0x3b => (ValueType::I32, 1),
        0x30 | 0x31 | 0x3c => (ValueType::I64, 0),
        0x32 | 0x33 | 0x3d => (ValueType::I64, 1),
        _ => (ValueType::I64, 2),
    }
}

struct ValidationContext {
    types: Vec[FuncType],
    functions: Vec[FuncType],
    globals: Vec[GlobalType],
    tables: Vec[TableType],
    memories: isize,
    elements: Vec[ValueType],
    data_count: isize,
    declared_data_count: Option[u32],
    declared_functions: HashMap[isize, bool],
    work: ValidationWork,
}

fn validation_is_reference(kind: ValueType) -> bool {
    kind == ValueType::FuncRef || kind == ValueType::ExternRef
}

fn validation_reference_immediate(value: u32) -> Option[ValueType] {
    if value == 0x70 {
        Option::Some(ValueType::FuncRef)
    } else if value == 0x6f {
        Option::Some(ValueType::ExternRef)
    } else {
        Option::None
    }
}

fn validation_block_signature(block: BlockType, context: ValidationContext, state: ValidationState) -> Result[
    FuncType,
    Error,
] {
    match block {
        BlockType::Empty => Result::Ok(FuncType { params: Vec::new(), results: Vec::new() }),
        BlockType::Value(kind) => Result::Ok(
            FuncType { params: Vec::new(), results: Vec::from_array([kind]) },
        ),
        BlockType::TypeIndex(index) => {
            if index < 0 || index >= context.types.len() {
                return Result::Err(state.problem("unknown block function type"))
            }
            Result::Ok(context.types[index])
        },
    }
}

fn validation_table(index: u32, context: ValidationContext, state: ValidationState) -> Result[
    ValueType,
    Error,
] {
    if index.to_u64() >= context.tables.len().to_u64() {
        return Result::Err(state.problem("unknown table"))
    }
    Result::Ok(context.tables[index.to_isize()].kind)
}

fn validation_bulk(instruction: Instruction, context: ValidationContext, state: ValidationState) -> Result[
    (),
    Error,
] {
    let op = instruction.op;
    match op {
        0xfc08 | 0xfc09 => {
            if context.declared_data_count.is_none() {
                return Result::Err(
                    state.problem("data index instruction requires data count section"),
                )
            }
            if instruction.a.to_u64() >= context.data_count.to_u64() {
                return Result::Err(state.problem("unknown data segment"))
            }
            if op == 0xfc08 {
                if context.memories == 0 || instruction.b != 0 {
                    return Result::Err(state.problem("memory.init requires memory zero"))
                }
                for _ in 0..3 {
                    state.pop(ValueType::I32)?;
                }
            }
        },
        0xfc0a | 0xfc0b => {
            if context.memories == 0 || instruction.a != 0 || (op == 0xfc0a && instruction.b != 0) {
                return Result::Err(state.problem("bulk memory instruction requires memory zero"))
            }
            for _ in 0..3 {
                state.pop(ValueType::I32)?;
            }
        },
        0xfc0c | 0xfc0d => {
            if instruction.a.to_u64() >= context.elements.len().to_u64() {
                return Result::Err(state.problem("unknown element segment"))
            }
            if op == 0xfc0c {
                let kind = validation_table(instruction.b, context, state)?;
                if kind != context.elements[instruction.a.to_isize()] {
                    return Result::Err(state.problem("table.init element type mismatch"))
                }
                for _ in 0..3 {
                    state.pop(ValueType::I32)?;
                }
            }
        },
        0xfc0e => {
            let destination = validation_table(instruction.a, context, state)?;
            let source = validation_table(instruction.b, context, state)?;
            if destination != source {
                return Result::Err(state.problem("table.copy element type mismatch"))
            }
            for _ in 0..3 {
                state.pop(ValueType::I32)?;
            }
        },
        0xfc0f | 0xfc10 | 0xfc11 => {
            let kind = validation_table(instruction.a, context, state)?;
            if op != 0xfc10 {
                state.pop(ValueType::I32)?;
                state.pop(kind)?;
            }
            if op == 0xfc11 {
                state.pop(ValueType::I32)?;
            } else {
                state.push(Option::Some(ValueType::I32))?;
            }
        },
        _ => return Result::Err(state.problem("unsupported bulk instruction")),
    }
    Result::Ok(())
}

fn validation_branch_match(
    actual: Vec[Option[ValueType]],
    expected: Vec[ValueType],
    state: ValidationState,
) -> Result[(), Error] {
    state.work.charge(actual.len())?;
    if actual.len() != expected.len() {
        return Result::Err(state.problem("branch table label arity mismatch"))
    }
    for i in 0..actual.len() {
        if let Some(kind) = actual[i] {
            if kind != expected[i] {
                return Result::Err(state.problem("branch table label type mismatch"))
            }
        }
    }
    Result::Ok(())
}

fn validate_function(function: Function, index: isize, context: ValidationContext, limits: Limits) -> Result[
    (),
    Error,
] {
    let signature = context.types[function.type_index];
    if signature.params.len() > limits.max_locals
        || function.locals.len() > limits.max_locals - signature.params.len() {
        return Result::Err(Error::Limit("function local limit exceeded"))
    }
    context.work.charge(signature.params.len())?;
    context.work.charge(function.locals.len())?;
    let locals = signature.params.as_slice().to_vec();
    locals.extend(function.locals);
    let state = ValidationState {
        function: index,
        offset: Ref::new(0),
        values: Vec::new(),
        controls: Vec::new(),
        limits,
        work: context.work,
    };
    state.open(-1, FuncType { params: Vec::new(), results: signature.results })?;
    for instruction in function.code {
        state.work.charge(1)?;
        state.offset.set(instruction.offset);
        if state.controls.is_empty() {
            return Result::Err(state.problem("instructions after function end"))
        }
        let op = instruction.op;
        match op {
            0x00 => state.unreachable(),
            0x01 => (),
            0x02 | 0x03 | 0x04 => {
                if op == 0x04 {
                    state.pop(ValueType::I32)?;
                }
                let block = validation_block_signature(instruction.block_type, context, state)?;
                state.pop_types(block.params)?;
                state.open(op, block)?;
                state.push_types(block.params)?;
            },
            0x05 => {
                let frame = state.controls[state.controls.len() - 1];
                if frame.op != 0x04 || frame.has_else.get() {
                    return Result::Err(state.problem("else without matching if"))
                }
                state.close_values(frame)?;
                frame.unreachable.set(false);
                frame.has_else.set(true);
                state.push_types(frame.params)?;
            },
            0x0b => {
                let frame = state.controls[state.controls.len() - 1];
                if frame.op == 0x04 && !frame.has_else.get() {
                    state.work.charge(frame.params.len())?;
                    if frame.params != frame.results {
                        return Result::Err(
                            state.problem("if without else must preserve its parameter types"),
                        )
                    }
                }
                state.close_values(frame)?;
                let _ = state.controls.pop();
                state.push_types(frame.results)?;
            },
            0x0c | 0x0d => {
                if op == 0x0d {
                    state.pop(ValueType::I32)?;
                }
                let target = state.label(instruction.a)?;
                state.pop_types(target)?;
                if op == 0x0c {
                    state.unreachable();
                } else {
                    state.push_types(target)?;
                }
            },
            0x0e => {
                if instruction.labels.len() > limits.max_items {
                    return Result::Err(Error::Limit("branch table label limit exceeded"))
                }
                state.pop(ValueType::I32)?;
                let target = state.label(instruction.a)?;
                let actual: Vec[Option[ValueType]] = Vec::new();
                for _ in 0..target.len() {
                    actual.push(state.pop_any()?);
                }
                actual.reverse();
                validation_branch_match(actual, target, state)?;
                for label in instruction.labels {
                    validation_branch_match(actual, state.label(label)?, state)?;
                }
                state.unreachable();
            },
            0x0f => {
                state.pop_types(signature.results)?;
                state.unreachable();
            },
            0x10 | 0x11 => {
                let signatures = if op == 0x10 {
                    context.functions
                } else {
                    context.types
                };
                if instruction.a.to_u64() >= signatures.len().to_u64() {
                    return Result::Err(state.problem("unknown function or function type"))
                }
                if op == 0x11 {
                    if validation_table(instruction.b, context, state)? != ValueType::FuncRef {
                        return Result::Err(state.problem("call_indirect requires a funcref table"))
                    }
                    state.pop(ValueType::I32)?;
                }
                state.call(signatures[instruction.a.to_isize()])?;
            },
            0x1a => {
                let _ = state.pop_any()?;
            },
            0x1b => {
                state.pop(ValueType::I32)?;
                let right = state.pop_any()?;
                let left = state.pop_any()?;
                if left.is_some() && right.is_some() && left != right {
                    return Result::Err(state.problem("select operand type mismatch"))
                }
                let kind = if left.is_some() {
                    left
                } else {
                    right
                };
                if let Some(kind) = kind {
                    if validation_is_reference(kind) {
                        return Result::Err(
                            state.problem("untyped select does not accept reference values"),
                        )
                    }
                }
                state.push(kind)?;
            },
            0x1c => {
                if instruction.select_types.len() != 1 {
                    return Result::Err(
                        state.problem("typed select requires exactly one result type"),
                    )
                }
                state.pop(ValueType::I32)?;
                let kind = instruction.select_types[0];
                state.pop(kind)?;
                state.pop(kind)?;
                state.push(Option::Some(kind))?;
            },
            0x20 | 0x21 | 0x22 => {
                if instruction.a.to_u64() >= locals.len().to_u64() {
                    return Result::Err(state.problem("unknown local"))
                }
                let kind = locals[instruction.a.to_isize()];
                if op != 0x20 {
                    state.pop(kind)?;
                }
                if op != 0x21 {
                    state.push(Option::Some(kind))?;
                }
            },
            0x23 | 0x24 => {
                if instruction.a.to_u64() >= context.globals.len().to_u64() {
                    return Result::Err(state.problem("unknown global"))
                }
                let global = context.globals[instruction.a.to_isize()];
                if op == 0x24 {
                    if !global.mutable {
                        return Result::Err(state.problem("global is immutable"))
                    }
                    state.pop(global.kind)?;
                } else {
                    state.push(Option::Some(global.kind))?;
                }
            },
            0x25 | 0x26 => {
                let kind = validation_table(instruction.a, context, state)?;
                if op == 0x26 {
                    state.pop(kind)?;
                }
                state.pop(ValueType::I32)?;
                if op == 0x25 {
                    state.push(Option::Some(kind))?;
                }
            },
            0x3f | 0x40 => {
                if context.memories == 0 || instruction.a != 0 {
                    return Result::Err(state.problem("memory instruction requires memory zero"))
                }
                if op == 0x40 {
                    state.pop(ValueType::I32)?;
                }
                state.push(Option::Some(ValueType::I32))?;
            },
            0x41 => state.push(Option::Some(ValueType::I32))?,
            0x42 => state.push(Option::Some(ValueType::I64))?,
            0x43 => state.push(Option::Some(ValueType::F32))?,
            0x44 => state.push(Option::Some(ValueType::F64))?,
            0xd0 => {
                let kind = validation_reference_immediate(instruction.a);
                if kind.is_none() {
                    return Result::Err(state.problem("invalid ref.null reference type"))
                }
                state.push(kind)?;
            },
            0xd1 => {
                if let Some(kind) = state.pop_any()? {
                    if !validation_is_reference(kind) {
                        return Result::Err(state.problem("ref.is_null requires a reference"))
                    }
                }
                state.push(Option::Some(ValueType::I32))?;
            },
            0xd2 => {
                if instruction.a.to_u64() >= context.functions.len().to_u64() {
                    return Result::Err(state.problem("unknown referenced function"))
                }
                if context.declared_functions.get(instruction.a.to_isize()).is_none() {
                    return Result::Err(
                        state.problem("ref.func function is not declared outside function bodies"),
                    )
                }
                state.push(Option::Some(ValueType::FuncRef))?;
            },
            _ => {
                if op >= 0x28 && op <= 0x3e {
                    if context.memories == 0 {
                        return Result::Err(state.problem("load/store requires a memory"))
                    }
                    let (kind, alignment) = validation_memory_signature(op);
                    if instruction.a > alignment {
                        return Result::Err(
                            state.problem("memory alignment exceeds natural alignment"),
                        )
                    }
                    if op >= 0x36 {
                        state.pop(kind)?;
                    }
                    state.pop(ValueType::I32)?;
                    if op < 0x36 {
                        state.push(Option::Some(kind))?;
                    }
                } else if let Some((kind, count, output)) = validation_numeric_signature(op) {
                    for _ in 0..count {
                        state.pop(kind)?;
                    }
                    state.push(Option::Some(output))?;
                } else if op >= 0xfc08 && op <= 0xfc11 {
                    validation_bulk(instruction, context, state)?;
                } else {
                    return Result::Err(state.problem("unsupported instruction"))
                }
            },
        }
    }
    if !state.controls.is_empty() {
        return Result::Err(state.problem("unterminated function or control frame"))
    }
    Result::Ok(())
}

fn validation_index(index: isize, length: isize, message: string) -> Result[(), Error] {
    if index < 0 || index >= length {
        Result::Err(Error::Validation(-1, 0, message))
    } else {
        Result::Ok(())
    }
}

fn validation_size(size: SizeLimits, memory: bool, limits: Limits) -> Result[(), Error] {
    if let Some(maximum) = size.max {
        if maximum < size.min {
            return Result::Err(Error::Validation(-1, 0, "size minimum exceeds maximum"))
        }
        if memory && maximum > 65536 {
            return Result::Err(Error::Validation(-1, 0, "memory maximum exceeds 65536 pages"))
        }
    }
    if memory && size.min > 65536 {
        return Result::Err(Error::Validation(-1, 0, "memory minimum exceeds 65536 pages"))
    }
    let budget = if memory {
        limits.max_memory_pages
    } else {
        limits.max_table_elements
    };
    if size.min.to_u64() > budget.to_u64() {
        return Result::Err(Error::Limit("memory or table minimum exceeds resource limit"))
    }
    Result::Ok(())
}

fn validate_constant(code: Vec[Instruction], expected: ValueType, context: ValidationContext) -> Result[
    (),
    Error,
] {
    context.work.charge(code.len())?;
    if code.len() != 2 || code[1].op != 0x0b {
        return Result::Err(Error::Validation(-1, 0, "constant expression must produce one value"))
    }
    let instruction = code[0];
    let kind = match instruction.op {
        0x41 => ValueType::I32,
        0x42 => ValueType::I64,
        0x43 => ValueType::F32,
        0x44 => ValueType::F64,
        0x23 => {
            if instruction.a.to_u64() >= context.globals.len().to_u64() {
                return Result::Err(
                    Error::Validation(-1, instruction.offset, "unknown constant global"),
                )
            }
            let global = context.globals[instruction.a.to_isize()];
            if global.mutable {
                return Result::Err(
                    Error::Validation(
                        -1,
                        instruction.offset,
                        "constant expression reads mutable global",
                    ),
                )
            }
            global.kind
        },
        0xd0 => match validation_reference_immediate(instruction.a) {
            Option::Some(kind) => kind,
            Option::None => return Result::Err(
                Error::Validation(-1, instruction.offset, "invalid constant reference type"),
            ),
        },
        0xd2 => {
            if instruction.a.to_u64() >= context.functions.len().to_u64() {
                return Result::Err(
                    Error::Validation(-1, instruction.offset, "unknown constant function"),
                )
            }
            if context.declared_functions.get(instruction.a.to_isize()).is_none() {
                return Result::Err(
                    Error::Validation(-1, instruction.offset, "constant function is not declared"),
                )
            }
            ValueType::FuncRef
        },
        _ => return Result::Err(
            Error::Validation(-1, instruction.offset, "non-constant initializer instruction"),
        ),
    };
    if kind != expected {
        return Result::Err(
            Error::Validation(-1, instruction.offset, "constant expression type mismatch"),
        )
    }
    Result::Ok(())
}

fn validation_count_instructions(code: Vec[Instruction], used: Ref[isize], limits: Limits) -> Result[
    (),
    Error,
] {
    if code.len() > limits.max_instructions - used.get() {
        return Result::Err(Error::Limit("module instruction limit exceeded"))
    }
    used.set(used.get() + code.len());
    Result::Ok(())
}

fn validation_declare(code: Vec[Instruction], declared: HashMap[isize, bool], work: ValidationWork) -> Result[
    (),
    Error,
] {
    work.charge(code.len())?;
    for instruction in code {
        if instruction.op == 0xd2 {
            declared.set(instruction.a.to_isize(), true);
        }
    }
    Result::Ok(())
}

fn validation_table_type(table: TableType, limits: Limits) -> Result[(), Error] {
    if !validation_is_reference(table.kind) {
        return Result::Err(Error::Validation(-1, 0, "table element type must be a reference"))
    }
    validation_size(table.limits, false, limits)
}

fn validate_module(data: ModuleData, limits: Limits) -> Result[(), Error] {
    limits.validate()?;
    let work = ValidationWork { limit: limits.max_validation_work, used: Ref::new(0) };
    work.charge(1)?;
    for length in[
        data.types.len(),
        data.imports.len(),
        data.functions.len(),
        data.tables.len(),
        data.memories.len(),
        data.globals.len(),
        data.exports.len(),
        data.data.len(),
        data.elements.len(),
    ] {
        work.charge(length)?;
        if length > limits.max_items {
            return Result::Err(Error::Limit("module item limit exceeded"))
        }
    }
    for signature in data.types {
        work.charge(signature.params.len())?;
        work.charge(signature.results.len())?;
        if signature.params.len() > limits.max_items || signature.params.len() > limits.max_locals {
            return Result::Err(Error::Limit("function parameter limit exceeded"))
        }
        if signature.results.len() > limits.max_items || signature.results.len() > limits.max_stack {
            return Result::Err(Error::Limit("function result limit exceeded"))
        }
    }
    if let Some(count) = data.data_count {
        if count.to_u64() != data.data.len().to_u64() {
            return Result::Err(Error::Validation(-1, 0, "data count does not match data segments"))
        }
    }
    let functions: Vec[FuncType] = Vec::new();
    let globals: Vec[GlobalType] = Vec::new();
    let tables: Vec[TableType] = Vec::new();
    let mut memories = 0;
    for imported in data.imports {
        work.charge(1)?;
        match imported.desc {
            ImportDesc::Func(index) => {
                validation_index(index, data.types.len(), "unknown imported function type")?;
                functions.push(data.types[index]);
            },
            ImportDesc::Table(table) => {
                validation_table_type(table, limits)?;
                tables.push(table);
            },
            ImportDesc::Memory(size) => {
                validation_size(size, true, limits)?;
                memories += 1;
            },
            ImportDesc::Global(kind) => globals.push(kind),
        }
    }
    let imported_functions = functions.len();
    let imported_globals = globals.copy();
    if data.functions.len() > limits.max_items - functions.len()
        || data.globals.len() > limits.max_items - globals.len()
        || data.tables.len() > limits.max_items - tables.len() {
        return Result::Err(Error::Limit("combined imported and defined item limit exceeded"))
    }
    for function in data.functions {
        work.charge(1)?;
        validation_index(function.type_index, data.types.len(), "unknown defined function type")?;
        functions.push(data.types[function.type_index]);
    }
    for table in data.tables {
        work.charge(1)?;
        validation_table_type(table, limits)?;
        tables.push(table);
    }
    for size in data.memories {
        work.charge(1)?;
        validation_size(size, true, limits)?;
        memories += 1;
    }
    if memories > 1 {
        return Result::Err(Error::Validation(-1, 0, "Core 2 permits at most one memory"))
    }
    let elements: Vec[ValueType] = Vec::new();
    let declared_functions: HashMap[isize, bool] = HashMap::new();
    for exported in data.exports {
        work.charge(1)?;
        if let ExportDesc::Func(index) = exported.desc {
            declared_functions.set(index, true);
        }
    }
    for global in data.globals {
        work.charge(1)?;
        validation_declare(global.init, declared_functions, work)?;
    }
    for segment in data.data {
        work.charge(1)?;
        validation_declare(segment.offset, declared_functions, work)?;
    }
    for segment in data.elements {
        work.charge(1)?;
        if !validation_is_reference(segment.kind) {
            return Result::Err(Error::Validation(-1, 0, "element segment type must be a reference"))
        }
        if segment.init.len() > limits.max_items {
            return Result::Err(Error::Limit("element segment item limit exceeded"))
        }
        work.charge(segment.init.len())?;
        elements.push(segment.kind);
        validation_declare(segment.offset, declared_functions, work)?;
        for init in segment.init {
            validation_declare(init, declared_functions, work)?;
        }
    }
    let constant_context = ValidationContext {
        types: data.types,
        functions,
        globals: imported_globals,
        tables,
        memories,
        elements,
        data_count: data.data.len(),
        declared_data_count: data.data_count,
        declared_functions,
        work,
    };
    let instructions = Ref::new(0);
    for global in data.globals {
        work.charge(1)?;
        validation_count_instructions(global.init, instructions, limits)?;
        validate_constant(global.init, global.global_type.kind, constant_context)?;
        globals.push(global.global_type);
    }
    let export_names: HashMap[string, bool] = HashMap::new();
    for exported in data.exports {
        work.charge(1)?;
        if export_names.get(exported.name).is_some() {
            return Result::Err(Error::Validation(-1, 0, "duplicate export name"))
        }
        export_names.set(exported.name, true);
        match exported.desc {
            ExportDesc::Func(index) => validation_index(
                index,
                functions.len(),
                "unknown function export",
            )?,
            ExportDesc::Global(index) => validation_index(
                index,
                globals.len(),
                "unknown global export",
            )?,
            ExportDesc::Memory(index) => validation_index(index, memories, "unknown memory export")?,
            ExportDesc::Table(index) => validation_index(
                index,
                tables.len(),
                "unknown table export",
            )?,
        }
    }
    if let Some(index) = data.start {
        validation_index(index, functions.len(), "unknown start function")?;
        let signature = functions[index];
        if !signature.params.is_empty() || !signature.results.is_empty() {
            return Result::Err(
                Error::Validation(-1, 0, "start function must have no parameters or results"),
            )
        }
    }
    for segment in data.data {
        work.charge(1)?;
        validation_count_instructions(segment.offset, instructions, limits)?;
        match segment.mode {
            SegmentMode::Active => {
                validation_index(segment.memory, memories, "unknown data segment memory")?;
                validate_constant(segment.offset, ValueType::I32, constant_context)?;
            },
            SegmentMode::Passive => {
                if !segment.offset.is_empty() {
                    return Result::Err(
                        Error::Validation(-1, 0, "passive data segment has an offset"),
                    )
                }
            },
            SegmentMode::Declarative => return Result::Err(
                Error::Validation(-1, 0, "data segments cannot be declarative"),
            ),
        }
    }
    for segment in data.elements {
        work.charge(1)?;
        validation_count_instructions(segment.offset, instructions, limits)?;
        match segment.mode {
            SegmentMode::Active => {
                validation_index(segment.table, tables.len(), "unknown element segment table")?;
                if tables[segment.table].kind != segment.kind {
                    return Result::Err(
                        Error::Validation(-1, 0, "active element segment table type mismatch"),
                    )
                }
                validate_constant(segment.offset, ValueType::I32, constant_context)?;
            },
            SegmentMode::Passive | SegmentMode::Declarative => {
                if !segment.offset.is_empty() {
                    return Result::Err(
                        Error::Validation(-1, 0, "inactive element segment has an offset"),
                    )
                }
            },
        }
        for init in segment.init {
            validation_count_instructions(init, instructions, limits)?;
            validate_constant(init, segment.kind, constant_context)?;
        }
    }
    let context = ValidationContext { globals, ..constant_context };
    for index in 0..data.functions.len() {
        let function = data.functions[index];
        validation_count_instructions(function.code, instructions, limits)?;
        validate_function(function, imported_functions + index, context, limits)?;
    }
    Result::Ok(())
}
