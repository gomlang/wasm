package main;

use ecosystem::wasm;
use std::testing;

pub fn add_module() -> Vec[u8] {
    // (module (func (export "add") (param i32 i32) (result i32)
    //   local.get 0 local.get 1 i32.add))
    Vec::from_array(
        [
            0,
            97,
            115,
            109,
            1,
            0,
            0,
            0,
            1,
            7,
            1,
            96,
            2,
            127,
            127,
            1,
            127,
            3,
            2,
            1,
            0,
            7,
            7,
            1,
            3,
            97,
            100,
            100,
            0,
            0,
            10,
            9,
            1,
            7,
            0,
            32,
            0,
            32,
            1,
            106,
            11,
        ],
    )
}

fn main() -> () {
    let module = testing::expect_ok(wasm::Module::new(add_module().as_slice()), "compile");
    let store = wasm::Store::new();
    let instance = testing::expect_ok(store.instantiate(module, wasm::Linker::new()), "instantiate");
    let result = testing::expect_ok(
        store.call(instance, "add", Vec::from_array([wasm::Value::I32(20), wasm::Value::I32(22)])),
        "call",
    );
    match result[0] {
        wasm::Value::I32(value) => println(value),
        _ => (),
    }
}
